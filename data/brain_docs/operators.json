{
  "_schema": {
    "_comment": "Brain operator reference. Seed entries cover the operators used in 101 Formulaic Alphas (Kakushadze 2015) plus standard Brain operator set. To extend: scrape platform.worldquantbrain.com/learn/operators using data/brain_docs/scrape_console.js and merge via training/convert_brain_md.py.",
    "_categories": ["arithmetic", "logical", "cross-sectional", "time-series", "group", "transformational", "special"]
  },

  "add": {"category": "arithmetic", "signature": "add(x, y)", "description": "Elementwise addition. Same as x + y."},
  "subtract": {"category": "arithmetic", "signature": "subtract(x, y)", "description": "Elementwise subtraction. Same as x - y."},
  "multiply": {"category": "arithmetic", "signature": "multiply(x, y)", "description": "Elementwise multiplication. Same as x * y."},
  "divide": {"category": "arithmetic", "signature": "divide(x, y)", "description": "Elementwise division. Same as x / y."},
  "abs": {"category": "arithmetic", "signature": "abs(x)", "description": "Absolute value."},
  "sign": {"category": "arithmetic", "signature": "sign(x)", "description": "Returns -1, 0, or 1."},
  "log": {"category": "arithmetic", "signature": "log(x)", "description": "Natural log."},
  "exp": {"category": "arithmetic", "signature": "exp(x)", "description": "e^x."},
  "sqrt": {"category": "arithmetic", "signature": "sqrt(x)", "description": "Square root."},
  "pow": {"category": "arithmetic", "signature": "pow(x, e)", "description": "x raised to the power e."},
  "signed_power": {"category": "arithmetic", "signature": "signed_power(x, e)", "description": "sign(x) * abs(x)^e. Preserves sign while reshaping magnitude."},
  "min": {"category": "arithmetic", "signature": "min(x, y)", "description": "Elementwise minimum."},
  "max": {"category": "arithmetic", "signature": "max(x, y)", "description": "Elementwise maximum."},
  "round": {"category": "arithmetic", "signature": "round(x)", "description": "Round to nearest integer."},
  "ceil": {"category": "arithmetic", "signature": "ceil(x)", "description": "Round up."},
  "floor": {"category": "arithmetic", "signature": "floor(x)", "description": "Round down."},

  "less": {"category": "logical", "signature": "less(x, y)", "description": "x < y (boolean)."},
  "greater": {"category": "logical", "signature": "greater(x, y)", "description": "x > y."},
  "equal": {"category": "logical", "signature": "equal(x, y)", "description": "x == y."},
  "if_else": {"category": "logical", "signature": "if_else(condition, then, else)", "description": "Conditional selection."},
  "and": {"category": "logical", "signature": "and(a, b)", "description": "Boolean AND."},
  "or": {"category": "logical", "signature": "or(a, b)", "description": "Boolean OR."},
  "not": {"category": "logical", "signature": "not(a)", "description": "Boolean NOT."},

  "rank": {"category": "cross-sectional", "signature": "rank(x)", "description": "Cross-sectional rank, mapped to [0, 1]."},
  "zscore": {"category": "cross-sectional", "signature": "zscore(x)", "description": "Cross-sectional standardization: (x - mean) / std. Takes EXACTLY one argument."},
  "normalize": {"category": "cross-sectional", "signature": "normalize(x)", "description": "Cross-sectional demean and rescale."},
  "quantile": {"category": "cross-sectional", "signature": "quantile(x, driver=gaussian, sigma=1.0)", "description": "Cross-sectional quantile transform."},
  "scale": {"category": "cross-sectional", "signature": "scale(x, scale=1)", "description": "L1-normalize across cross-section so sum(|x|)=scale. OPTIONAL — Brain auto-normalizes via truncation/neutralization. Not required as outer wrapper."},

  "ts_mean": {"category": "time-series", "signature": "ts_mean(x, d)", "description": "Mean of x over past d days."},
  "ts_sum": {"category": "time-series", "signature": "ts_sum(x, d)", "description": "Sum of x over past d days."},
  "ts_product": {"category": "time-series", "signature": "ts_product(x, d)", "description": "Product over past d days."},
  "ts_std_dev": {"category": "time-series", "signature": "ts_std_dev(x, d)", "description": "Trailing std-dev over d days."},
  "ts_delta": {"category": "time-series", "signature": "ts_delta(x, d)", "description": "x_today - x_{d days ago}."},
  "ts_delay": {"category": "time-series", "signature": "ts_delay(x, d)", "description": "Value of x as of d days ago (no aggregation)."},
  "ts_corr": {"category": "time-series", "signature": "ts_corr(x, y, d)", "description": "Trailing d-day Pearson correlation between vectors x and y."},
  "ts_covariance": {"category": "time-series", "signature": "ts_covariance(x, y, d)", "description": "Trailing d-day covariance."},
  "ts_zscore": {"category": "time-series", "signature": "ts_zscore(x, d)", "description": "(x - ts_mean(x, d)) / ts_std_dev(x, d)."},
  "ts_rank": {"category": "time-series", "signature": "ts_rank(x, d)", "description": "Rank of x_today within trailing d-day window, normalized to [0,1]."},
  "ts_max": {"category": "time-series", "signature": "ts_max(x, d)", "description": "Maximum of x over past d days."},
  "ts_min": {"category": "time-series", "signature": "ts_min(x, d)", "description": "Minimum of x over past d days."},
  "ts_arg_max": {"category": "time-series", "signature": "ts_arg_max(x, d)", "description": "Days-since-max within the past d days."},
  "ts_arg_min": {"category": "time-series", "signature": "ts_arg_min(x, d)", "description": "Days-since-min within the past d days."},
  "ts_decay_linear": {"category": "time-series", "signature": "ts_decay_linear(x, d)", "description": "Linearly weighted moving average over past d days, most-recent day weighted most heavily."},
  "ts_skewness": {"category": "time-series", "signature": "ts_skewness(x, d)", "description": "Trailing d-day sample skewness."},
  "ts_kurtosis": {"category": "time-series", "signature": "ts_kurtosis(x, d)", "description": "Trailing d-day sample kurtosis."},
  "ts_count_nans": {"category": "time-series", "signature": "ts_count_nans(x, d)", "description": "Number of NaNs over past d days."},
  "ts_returns": {"category": "time-series", "signature": "ts_returns(x, d)", "description": "(x_today / x_{d days ago}) - 1."},

  "group_neutralize": {"category": "group", "signature": "group_neutralize(x, group)", "description": "Subtract the group mean of x within each group (e.g. sector, industry, subindustry)."},
  "group_rank": {"category": "group", "signature": "group_rank(x, group)", "description": "Rank within each group."},
  "group_mean": {"category": "group", "signature": "group_mean(x, weight, group)", "description": "Weighted mean within group."},
  "group_zscore": {"category": "group", "signature": "group_zscore(x, group)", "description": "Z-score within group."},
  "group_sum": {"category": "group", "signature": "group_sum(x, group)", "description": "Sum within group."},
  "group_max": {"category": "group", "signature": "group_max(x, group)", "description": "Max within group."},
  "group_min": {"category": "group", "signature": "group_min(x, group)", "description": "Min within group."}
}
